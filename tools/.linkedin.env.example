# Create a LinkedIn developer app, add the "Share on LinkedIn" product, and
# register this exact redirect URL in its Auth settings before authorizing.
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Update only if LinkedIn's supported Posts API version changes.
LINKEDIN_API_VERSION=202606
