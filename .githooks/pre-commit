#!/bin/sh
# ─── SkillMe Pre-Commit Hook ───
# Validates JavaScript syntax before every commit.
# Catches SyntaxErrors that would silently break the frontend.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🔍 Pre-commit: Checking JavaScript syntax...${NC}"

# JS/CSS are cached for a year (immutable), so every edited asset needs a new ?v= hash
# in the HTML. bump_versions.py --check fails if any page still points at an old version.
ASSETS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.css' '*.html' | grep -v '/' )
if [ -n "$ASSETS" ]; then
  PY=$(command -v python3 || command -v python)
  if [ -n "$PY" ] && ! "$PY" bump_versions.py --check; then
    echo "${RED}✗ COMMIT BLOCKED — run: python bump_versions.py  (then stage the updated .html files)${NC}"
    exit 1
  fi
fi

# Find all staged .js files (Added, Copied, Modified, Renamed)
JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js')

if [ -z "$JS_FILES" ]; then
  echo "${GREEN}✓ No JavaScript files staged — skipping syntax check.${NC}"
  exit 0
fi

ERRORS=0
for file in $JS_FILES; do
  if [ -f "$file" ]; then
    if ! node -c "$file" 2>/dev/null; then
      echo "${RED}✗ Syntax error in: $file${NC}"
      node -c "$file"  # Run again to show the actual error
      ERRORS=$((ERRORS + 1))
    else
      echo "${GREEN}✓ $file${NC}"
    fi
  fi
done

if [ $ERRORS -gt 0 ]; then
  echo ""
  echo "${RED}✗ COMMIT BLOCKED — $ERRORS file(s) have JavaScript syntax errors.${NC}"
  echo "${YELLOW}  Fix the errors above, then try committing again.${NC}"
  exit 1
fi

echo "${GREEN}✓ All JavaScript files pass syntax check.${NC}"
exit 0
