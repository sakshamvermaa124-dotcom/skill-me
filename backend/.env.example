# SkillMe Backend — Environment Variables
# Copy this file to .env and fill in your values

# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_ORG=skillme-oss

# Server
PORT=8000
HOST=0.0.0.0

# Webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Admin Auth (simple shared secret for MVP)
ADMIN_API_KEY=your_admin_api_key_here

# Database
DATABASE_PATH=data/skillme.db

# ── Email (Brevo SMTP relay) ────────────────────────────────────────────────
# Sign up at https://app.brevo.com → Settings → SMTP & API → Generate SMTP Key
# Your Brevo login email goes in SMTP_USER, the generated key in SMTP_PASSWORD
EMAIL_ENABLED=False
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_key_here
SMTP_FROM_NAME=SkillMe Team
SMTP_FROM_EMAIL=noreply@yourdomain.com  # Must be a verified sender in Brevo
FRONTEND_URL=http://localhost:8080       # Change to prod URL when deploying

# ── Razorpay (Payments) ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
CERTIFICATE_PRICE_PAISE=24900
