# SkillMe Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8000
HOST=0.0.0.0

# Admin Auth (simple shared secret for MVP)
ADMIN_API_KEY=your_admin_api_key_here

# Database
# Leave TURSO_DB_URL unset to use a local SQLite file (local.db)
# TURSO_DB_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# ── Email (Brevo SMTP relay) ────────────────────────────────────────────────
# Sign up at https://app.brevo.com → Settings → SMTP & API → Generate SMTP Key
# Your Brevo login email goes in SMTP_USER, the generated key in SMTP_PASSWORD
EMAIL_ENABLED=False
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_key_here
SMTP_FROM_NAME=SkillMe Team
SMTP_FROM_EMAIL=noreply@yourdomain.com  # Must be a verified sender in Brevo
FRONTEND_URL=http://localhost:8080       # Change to prod URL when deploying

# Open/click/bounce/spam tracking: in Brevo → Transactional → Settings → Webhooks,
# add https://<your-backend>/api/webhooks/brevo?key=<this value>, subscribed to all events.
BREVO_WEBHOOK_SECRET=changeme-generate-a-random-string
# Extra Brevo accounts, used when the primary runs out of its daily quota (JSON list).
# SMTP_EXTRA_ACCOUNTS=[{"user": "xxxx@smtp-brevo.com", "password": "xsmtpsib-..."}]
# Brevo v3 REST API keys (Settings → SMTP & API → API Keys — NOT the SMTP key above).
# Strongly recommended for EVERY account: the app reads Brevo's real remaining daily credits and
# never sends through an exhausted account (Brevo accepts that mail and silently drops it).
# Without a key, an account falls back to our own count since 00:00 UTC (SMTP_DAILY_LIMIT).
BREVO_API_KEY=
# Comma-separated API keys of the SMTP_EXTRA_ACCOUNTS accounts (matched to their logins automatically).
BREVO_EXTRA_API_KEYS=

# ── Razorpay (Payments) ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
CERTIFICATE_PRICE_PAISE=24900
