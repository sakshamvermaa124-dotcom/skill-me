# SkillMe — Render Production Environment Variables
# Add these in your Render dashboard → Service → Environment
# DO NOT commit this file with real values

# Server
PORT=10000
HOST=0.0.0.0

# Security
ADMIN_API_KEY=change_this_to_a_strong_random_key

# Database — Render persistent disk mounts at /data
DATABASE_PATH=/data/skillme.db

# CORS — set to your Vercel URL after frontend deploys
ALLOWED_ORIGINS=https://skill-me.vercel.app,https://yourdomain.com

# Email (Brevo)
EMAIL_ENABLED=True
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_NAME=SkillMe Team
SMTP_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=https://skill-me.vercel.app   # Change to your Vercel URL

# Razorpay (add when ready)
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_secret
CERTIFICATE_PRICE_PAISE=24900
