# SkillMe — Production Environment Variables (Google Cloud Run)
# Set these as environment variables on the Cloud Run service
# DO NOT commit this file with real values

# Server
PORT=8080
HOST=0.0.0.0

# Security
ADMIN_API_KEY=change_this_to_a_strong_random_key

# Database — Turso (libSQL)
TURSO_DB_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Student session signing
JWT_SECRET_KEY=change_this_to_a_long_random_string

# CORS — set to your frontend URL
ALLOWED_ORIGINS=https://www.skill-me-intern.in

# Email (Brevo)
EMAIL_ENABLED=True
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_NAME=SkillMe Team
SMTP_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=https://www.skill-me-intern.in

# Open/click/bounce/spam tracking: in Brevo → Transactional → Settings → Webhooks,
# add https://<your-backend>/api/webhooks/brevo?key=<this value>, subscribed to all events.
BREVO_WEBHOOK_SECRET=changeme-generate-a-random-string

# Razorpay (add when ready)
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_secret
CERTIFICATE_PRICE_PAISE=24900
